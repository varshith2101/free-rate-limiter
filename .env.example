# Environment Configuration Example
# Copy this file to .env and update with your values

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# External Database URL (Neon, Supabase, etc.)
# Use postgresql://... (the app will prefix jdbc: in prod)
# Fill in your own database settings below.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Dashboard Configuration
VITE_API_URL=/api/v1
VITE_AUTH_MODE=standard

# Security (Generate secure keys for production!)
# You can use: openssl rand -base64 32
# Set a secure JWT secret for your instance.
JWT_SECRET=

# Auth Mode
# standard: email + OTP signup
# solo: admin login using env credentials (OTP disabled)
AUTH_MODE=standard
ADMIN_EMAIL=admin@rate-limiter.local
ADMIN_PASSWORD=change-this-password

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Provide your SMTP username and app password below.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@rate-limiter.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false
MAIL_SSL_TRUST=smtp.gmail.com
MAIL_CONNECTION_TIMEOUT=10000
MAIL_TIMEOUT=10000
MAIL_WRITE_TIMEOUT=10000
